root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,js,html}]
indent_style = space
indent_size = 4

[*.{json,scss,css,yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Test fixtures are data, and some are asserted byte for byte. Normalising
# whitespace on save silently breaks those assertions.
[src/test/resources/**]
insert_final_newline = false
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
